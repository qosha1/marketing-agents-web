# VARIANT B — the LOCAL tenant. This is the default way to run this app.
#
# You do not normally copy this file anywhere. `local-stack/up.sh` EXPORTS these
# values into the `pnpm dev` it starts, which is better than writing
# `.env.local` for two reasons: it cannot clobber a file you already have, and
# because Next never overrides a variable that is already in the environment,
# these WIN over a `.env.local` that happens to hold the production-tenant
# variant. A stack that wrote `.env.local` would leave the prod-pointing values
# sitting there for the next bare `pnpm dev`.
#
# It is committed so that the values are reviewable, greppable, and diffable
# against Variant A — the difference between the two files is the entire
# difference between "local" and "production", and that belongs in git.
#
# To run the frontend ALONE against an already-running local tenant
# (`./local-stack/up.sh` having been run before, or the backend started by
# hand), copy it: `cp local-stack/env.variantB .env.local && pnpm dev -p 4296`.

# Branding + the ?app= hint central auth is given. Also what makes the token's
# audience `tenant:marketing-agents`.
NEXT_PUBLIC_APP_SLUG=marketing-agents

# RELATIVE on purpose. A relative auth host emits a same-origin redirect, so the
# sign-in round-trip never names a host and survives being tunneled under some
# other hostname (a DebuggAI browser check). An absolute http://localhost:4014
# would escape the tunnel and die on the remote browser's own empty localhost.
NEXT_PUBLIC_AUTH_HOST=/auth

# EMPTY, not absent-and-hope. The browser must call /api/* same-origin so the
# gateway can route it; a set value makes the browser call an absolute host and
# bounce off CORS.
NEXT_PUBLIC_API_URL=

# The LOCAL tenant backend (tenant-starter on sqlite), which next.config.ts
# proxies /api/* to server-side. THE ONE LINE THAT DIFFERS IN KIND from Variant
# A: there, this is a proxy to a paying customer's production database.
DJANGO_API_URL=http://127.0.0.1:8466

DJANGO_ALLOWED_HOSTS=localhost

# ── THE WRITER WEBHOOK, POINTED AT NOTHING (bd startsim-m7fdm.19) ────────────
# /actions/generate-drafts falls back to the REAL OGMC n8n webhook when this is
# unset, and that webhook accepts unauthenticated POSTs. So on the offline stack
# — with no live tenant anywhere in the picture — pressing "Generate drafts", or
# now simply APPROVING A TOPIC, fired the production writer against a local
# topic id: real LLM spend, and a draft upserted into a paying customer's tenant
# for a topic that exists only on this laptop. The route's own test file already
# stubs `fetch` for exactly this reason; the dev server had no such guard.
#
# 127.0.0.1:1 is chosen to be unreachable rather than merely wrong: the relay
# fails fast with ECONNREFUSED, the route answers 502, and the UI shows its real
# refusal path ("Approved, but the draft could not be started…"). A URL that
# merely 404s would exercise a different arm, and a URL that 200s would make the
# app claim a writer is running when nothing is.
N8N_WRITER_WEBHOOK_URL=http://127.0.0.1:1/offline-stack-has-no-writer
