# The offline local stack for marketing-agents-web — bd startsim-768w.69.
# Read by start-simpli-api/tenant-starter/local-stack/stack.sh via ./up.sh.

STACK_SLUG=marketing-agents

# The org every seeded row carries and every minted token claims. THESE MUST
# AGREE: org_id is taken from the JWT claim and never from client input, so a
# token claiming one org over rows written under another produces `count: 0`
# across a fully seeded database — which reads exactly like "nothing seeded".
STACK_ORG_ID=marketing-agents

# Ports. Deliberately NOT the mcr stack's (8465/4297/4013) so both forks can run
# at once; the gateway is the only one a browser ever needs.
STACK_PORT_DEVAUTH=8401
STACK_PORT_TENANT=8466
STACK_PORT_FRONTEND=4296
STACK_PORT_GATEWAY=4014

STACK_DEVAUTH_CONFIG=local-stack/devauth.json

# Schema BEFORE rows, and the scope primitive BEFORE the types that resolve
# through it. Order in this list is the order they are applied.
STACK_SCHEMAS="local-stack/schema/marketing-agents.json"

STACK_FIXTURES="local-stack/fixtures/scopes.json local-stack/fixtures/clients.json local-stack/fixtures/topics.json local-stack/fixtures/drafts.json local-stack/fixtures/news.json local-stack/fixtures/sources.json"

STACK_REDENORMALIZE_TYPES="scope client topic draft news_item source"
